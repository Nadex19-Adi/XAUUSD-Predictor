# Ignore large dataset files and temporary artifacts

# Datasets (big CSV/ZIP files)
datasets/
data/chromadb/
*.zip
*.csv

# Model binaries (optional, can be large – you may keep them versioned if needed)
models/*.bst
models/*.json

# Python cache
__pycache__/
*.pyc

# Jupyter notebooks checkpoints
.ipynb_checkpoints/

# VSCode / IDE settings
.vscode/
.idea/

# Environment files
.env
.env.*

# API folder
api/

# Temporary files
*.log
*.tmp
